{
  "felixonmars-cn": {
    "repository": "felixonmars/dnsmasq-china-list",
    "branch": "master",
    "path": "accelerated-domains.china.conf",
    "format": "dnsmasq",
    "license": "WTFPL",
    "license_branch": "master",
    "license_path": "LICENSE",
    "min_entries": 1000,
    "max_entries": 300000,
    "must_not_match": [
      "play.googleapis.com",
      "android.clients.google.com",
      "accounts.google.com",
      "mtalk.google.com"
    ]
  },
  "gaoyifan-cn-ipv4": {
    "repository": "gaoyifan/china-operator-ip",
    "branch": "ip-lists",
    "path": "china.txt",
