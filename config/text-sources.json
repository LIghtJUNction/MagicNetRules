    "license": "MIT",
    "license_branch": "master",
    "license_path": "LICENSE",
    "min_entries": 1000,
    "max_entries": 100000
  },
  "gaoyifan-cn-ipv6": {
    "repository": "gaoyifan/china-operator-ip",
    "branch": "ip-lists",
    "path": "china6.txt",
    "format": "cidr6",
    "license": "MIT",
    "license_branch": "master",
    "license_path": "LICENSE",
    "min_entries": 100,
    "max_entries": 100000
  },
  "blackmatrix-google": {
    "repository": "blackmatrix7/ios_rule_script",
