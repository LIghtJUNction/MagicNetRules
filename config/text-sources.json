    "max_entries": 10000,
    "omit_types": [
      "IP-CIDR",
      "IP-CIDR6",
      "PROCESS-NAME"
    ]
  },
  "blackmatrix-google-fcm": {
    "repository": "blackmatrix7/ios_rule_script",
